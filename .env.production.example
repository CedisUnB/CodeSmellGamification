# Host PostgreSQL reachable from the Docker production network.
# For APP_NETWORK_SUBNET=192.168.1.0/24, Docker uses 192.168.1.1 as gateway.
POSTGRES_HOST=192.168.1.1
POSTGRES_PORT=5432
POSTGRES_DB=code_smell_gamification
POSTGRES_USER=devdog_appuser
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://devdog_appuser:change-me@192.168.1.1:5432/code_smell_gamification?schema=public
JWT_SECRET=change-me-too

# Dedicated Docker subnet for production containers. Mirror this subnet in
# the host PostgreSQL pg_hba.conf for a narrow allowlist.
APP_NETWORK_SUBNET=192.168.1.0/24

API_BIND_PORT=13000
WEB_BIND_PORT=18080
VITE_API_URL=/api
VITE_GOOGLE_ANALYTICS_ID=
