# Host PostgreSQL reachable from the Docker production network.
# For APP_NETWORK_SUBNET=172.30.10.0/24, Docker uses 172.30.10.1 as gateway.
POSTGRES_HOST=172.30.10.1
POSTGRES_PORT=5432
POSTGRES_DB=code_smell_gamification
POSTGRES_USER=devdog_appuser
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://devdog_appuser:change-me@172.30.10.1:5432/code_smell_gamification?schema=public
JWT_SECRET=change-me-too

# Dedicated Docker subnet for production containers. Mirror this subnet in
# the host PostgreSQL pg_hba.conf for a narrow allowlist.
APP_NETWORK_SUBNET=172.30.10.0/24

API_BIND_PORT=13000
WEB_BIND_PORT=18080

NGINX_SERVER_NAME=example.com
NGINX_SSL_CERTIFICATE=/etc/letsencrypt/live/example.com/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/example.com/privkey.pem
NGINX_CLIENT_MAX_BODY_SIZE=20M
