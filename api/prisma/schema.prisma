generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  isAnonymous Boolean  @default(true)
  name        String   @default("Anônimo")
  email       String?  @unique
  password    String?
  coins       Int      @default(0)
  createdAt   DateTime @default(now())
  mergedToId  String?
  updatedAt   DateTime @updatedAt

  attempts Attempt[]

  @@index([email])
  @@index([isAnonymous])
}

model Exercise {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  difficulty  Difficulty
  code        String

  smellLines SmellLine[]
  attempts   Attempt[]

  @@index([difficulty])
}

model SmellLine {
  id         String    @id @default(uuid())
  exerciseId Int
  smellType  SmellType
  line       Int

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, line]) // Uma linha não pode ter dois smells no mesmo exercício
  @@index([exerciseId])
  @@index([smellType])
}

model Attempt {
  id            String   @id @default(uuid())
  submittedAt   DateTime @default(now())
  userId        String
  exerciseId    Int
  correctLines  Int
  correctSmells Int
  attemptData   Json?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SmellType {
  MYSTERIOUS_NAME
  DUPLICATED_CODE
  LONG_METHOD
  LONG_PARAMETER_LIST
  GLOBAL_DATA
  MUTABLE_DATA
  DIVERGENT_CHANGE
  SHOTGUN_SURGERY
  FEATURE_ENVY
  DATA_CLUMPS
  PRIMITIVE_OBSESSION
  REPEATED_SWITCHES
  LAZY_ELEMENT
  SPECULATIVE_GENERALITY
  TEMPORARY_FIELD
  MESSAGE_CHAINS
  MIDDLE_MAN
  LARGE_CLASS
  COMMENTS
}

model Guide {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
